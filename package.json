{
  "name": "eshop-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr app/entry-server.ts --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server/server.ts",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@tanstack/vue-query": "^5.108.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "primevue": "~4.5.5",
    "sirv": "^3.0.2",
    "vue": "^3.5.42",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.11"
  }
}
